# Cofinder — client env (Expo)
# Copy to .env and fill. Only EXPO_PUBLIC_* vars are bundled into the app.
# The anon key is safe to ship to clients because every table is protected by RLS.

EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# -----------------------------------------------------------------------------
# SERVER-SIDE SECRETS — DO NOT put these in this client app or in EXPO_PUBLIC_*.
# They live only as Supabase Edge Function secrets:
#   supabase secrets set GOOGLE_PLACES_API_KEY=...
#   supabase secrets set SUPABASE_SERVICE_ROLE_KEY=...
# Listed here for documentation only.
# -----------------------------------------------------------------------------
# GOOGLE_PLACES_API_KEY=change-me-server-side-only
# SUPABASE_SERVICE_ROLE_KEY=change-me-server-side-only
