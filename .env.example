# Cofinder — client env (Expo)
# Copy to .env and fill. Only EXPO_PUBLIC_* vars are bundled into the app.
# The anon key is safe to ship to clients because every table is protected by RLS.

EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# -----------------------------------------------------------------------------
# SERVER-SIDE SECRETS — DO NOT put these in this client app or in EXPO_PUBLIC_*.
# Edge Function secrets (set with `supabase secrets set NAME=...`):
#   GOOGLE_PLACES_API_KEY, SUPABASE_SERVICE_ROLE_KEY
# Google OAuth provider (read by config.toml; set in supabase/.env for local dev):
#   SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID, SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET
# Listed here for documentation only.
# -----------------------------------------------------------------------------
# GOOGLE_PLACES_API_KEY=change-me-server-side-only
# SUPABASE_SERVICE_ROLE_KEY=change-me-server-side-only
# SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=change-me-server-side-only
# SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=change-me-server-side-only
